{
  "policy": "kubeai",
  "poll_interval": 1,
  "stale_after": 10,
  "max_inflight": 128,
  "replicas": [
    {
      "name": "replica-a-local",
      "url": "http://127.0.0.1:8001",
      "models": [
        "Qwen/Qwen3-0.6B"
      ],
      "capacity": 1,
      "token_seconds": 0.01,
      "prefill_seconds": 0.02,
      "max_model_len": 2048,
      "api_key_env": "",
      "gpu_metrics_url": ""
    },
    {
      "name": "replica-b-loal",
      "url": "http://127.0.0.1:8002",
      "models": [
        "Qwen/Qwen3-0.6B"
      ],
      "capacity": 1,
      "token_seconds": 0.01,
      "prefill_seconds": 0.02,
      "max_model_len": 2048,
      "api_key_env": "",
      "gpu_metrics_url": ""
    }
  ]
}
